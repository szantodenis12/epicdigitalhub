# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Claude API key for the free audit (/audit). From Roland.
ANTHROPIC_API_KEY=

# Upstash Redis - added automatically when the Upstash integration is
# connected from the Vercel Marketplace (either name pair works).
# Unset locally = submissions go to ./data/*.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend - email notification for every application and lead.
RESEND_API_KEY=
LEADS_EMAIL_TO=hello.epicdigitalhub@gmail.com
# Must be on a domain verified in Resend. Until then, leave empty: Resend's
# onboarding@resend.dev is used, which only delivers to the Resend account's
# own email address.
LEADS_EMAIL_FROM=
