# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Shared password for the internal dashboard at /admin. Required: without it
# /admin is inaccessible (not open). Same value on Vercel.
ADMIN_PASSWORD=

# Claude API key for the free audit (/audit). From Roland.
ANTHROPIC_API_KEY=

# Supabase (Postgres) - where every form submission is stored. The team's
# existing project, the same one the ticketing platform runs on. Schema:
# supabase/0001_site_leads.sql.
#
# SUPABASE_URL          Project Settings -> Data API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY  Project Settings -> API Keys -> service_role
#                       (starts with sb_secret_). It bypasses RLS, so it is
#                       server-only: never prefix it with NEXT_PUBLIC_.
#
# Both unset locally = submissions go to ./data/*.json instead, and /admin
# reads those files - i.e. you see local test data, not the real leads. To see
# what is actually on the site, copy the real values here.
# Both unset on Vercel = nothing is stored at all (only the email is sent).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend - email notification for every application and lead.
RESEND_API_KEY=
LEADS_EMAIL_TO=hello.epicdigitalhub@gmail.com
# Must be on a domain verified in Resend. Until then, leave empty: Resend's
# onboarding@resend.dev is used, which only delivers to the Resend account's
# own email address.
LEADS_EMAIL_FROM=
