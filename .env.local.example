# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# /admin sign-in uses Supabase Auth (the team's accounts, same as
# team.epicdigitalhub.ro). Access = a row in public.profiles with active = true.
# There is no shared password any more.
#
# SUPABASE_ANON_KEY   Project Settings -> API Keys -> publishable
#                       (sb_publishable_..., or the legacy "anon" key). Read on
#                       the server only - there is no browser Supabase client
#                       here - so NO NEXT_PUBLIC_ prefix. Required on Vercel
#                       too: without it /admin is inaccessible (not open).
SUPABASE_ANON_KEY=

# Claude API key for the free audit (/audit). From Roland.
ANTHROPIC_API_KEY=

# Supabase (Postgres) - where every form submission is stored. The team's
# existing project, the same one the ticketing platform runs on. Schema:
# supabase/0001_site_leads.sql.
#
# SUPABASE_URL          Project Settings -> Data API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY  Project Settings -> API Keys -> service_role
#                       (starts with sb_secret_). It bypasses RLS, so it is
#                       server-only: never prefix it with NEXT_PUBLIC_.
#
# Both unset locally = submissions go to ./data/*.json instead, and /admin
# reads those files - i.e. you see local test data, not the real leads. To see
# what is actually on the site, copy the real values here.
# Both unset on Vercel = nothing is stored at all (only the email is sent).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend - email notification for every application and lead.
RESEND_API_KEY=
LEADS_EMAIL_TO=hello.epicdigitalhub@gmail.com
# Must be on a domain verified in Resend. Until then, leave empty: Resend's
# onboarding@resend.dev is used, which only delivers to the Resend account's
# own email address.
LEADS_EMAIL_FROM=

# Vercel Web Analytics - visitor numbers shown in /admin. Without the token
# and project id the panel says "not configured" instead of showing zeros.
# All server-only: never prefix with NEXT_PUBLIC_.
#
# VERCEL_ANALYTICS_TOKEN       Vercel -> Account Settings -> Tokens (read access
#                       to the team that owns the project)
# VERCEL_ANALYTICS_PROJECT_ID  Project Settings -> General -> Project ID (prj_...)
# VERCEL_ANALYTICS_TEAM_ID     Only if the project belongs to a team (team_...);
#                       leave empty otherwise.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Meta Conversions API (server-side Lead events). META_CAPI_TOKEN: Events
# Manager -> Settings -> Conversions API -> generate access token. Unset = no
# events are sent (the app still works). META_PIXEL_ID defaults to the site's.
META_CAPI_TOKEN=
META_PIXEL_ID=
# Graph API version. Default v26.0; v21.0 is removed on 21 Jan 2027.
META_GRAPH_VERSION=
# TESTING ONLY: code from Events Manager -> Test events. Events then show up
# there. Remove it afterwards, or real events keep being flagged as tests.
META_TEST_EVENT_CODE=
